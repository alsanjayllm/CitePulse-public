# Copy this file to .env and adjust as needed. Every value below has a
# working default — nothing here is required to run your first audit.

# --- Local Ollama (default AI engine, no API key needed) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Optional: bring your own real AI-engine key instead of/alongside Ollama ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=

# --- Optional: bring your own search fallback key (used only if
# DuckDuckGo/Google News return nothing) ---
# SERPER_API_KEY=
# TAVILY_API_KEY=
# BING_API_KEY=

# --- Remediation ---
# Off by default: raw, deterministic template text only. Turn on to have the
# local LLM rephrase (never invent facts into) the remediation text.
REMEDIATION_LLM_POLISH=false

# --- Logging (local file only -- never sent anywhere) ---
LOG_LEVEL=INFO

# --- Data & retention ---
CITEPULSE_DATA_DIR=~/.citepulse
RETENTION_KEEP_LAST_RUNS=20
RETENTION_KEEP_DAYS=90

# --- Sites ---
MAX_SITES=10
